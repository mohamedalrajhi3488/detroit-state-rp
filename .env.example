# Development example environment variables
# Copy this to a file named .env and fill the values (DO NOT commit .env)

# For OAuth (web login) used by server.js
CLIENT_ID=your_discord_oauth_client_id
CLIENT_SECRET=your_discord_oauth_client_secret
REDIRECT_URI=http://localhost:3000/auth/discord/callback

# If you also run a Discord bot process, add the bot token here (optional)
# If you also run a Discord bot process, add the bot token here (optional)
DISCORD_TOKEN=your_discord_bot_token

# Webhook for logging Test/Application submissions
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# Rename this file to .env and fill the values
CLIENT_ID=your_discord_client_id
CLIENT_SECRET=your_discord_client_secret
# The redirect URI you set in your Discord app (must match)
REDIRECT_URI=http://localhost:3000/auth/discord/callback
PORT=3000
